[case testFunctionWorkLimitRollsBackInferredAttributes]
# flags: --max-function-work=50
from typing import Generic, TypeVar, Union
T = TypeVar("T")
class Box(Generic[T]):
    def __init__(self, x: T) -> None:
        self.x = x
class C:
    def __init__(self, u: Union[int, str]) -> None:
        a = Box(u)
        b = Box(a)
        c = Box(b)
        d = Box(c)
        e = Box(d)
        self.attr = e
    def later(self) -> str:
        return self.attr
[out]
main:8: error: Function "__init__" was not fully type checked: exceeded the configured per-function work limit of 50 work units
main:8: note: This function contains overly complex type inference (e.g. deeply nested or recursive generics). Simplify it, or increase the limit using --max-function-work (0 means no limit)
main:16: error: Cannot determine type of "attr"

